# ============================================================
# Candori GreenSight - 위성 API 인증 설정
# ============================================================
# 이 파일을 .env 로 복사한 뒤 값을 입력하세요.
#   copy .env.example .env
#
# 모든 항목은 선택사항입니다.
# 키가 없으면 해당 위성은 시뮬레이션 데이터를 사용합니다.
# ============================================================

# ── 1. Planet Insights Platform (PlanetScope 3m 매일) ──────
# Education/Research 계정 승인 후:
# https://insights.planet.com → Settings → OAuth Clients
# "New OAuth Client" 클릭 → Client ID / Secret 복사
PLANET_INSIGHTS_CLIENT_ID=
PLANET_INSIGHTS_CLIENT_SECRET=

# ── 2. Sentinel Hub (Sentinel-2 10m NDVI 이미지) ──────────
# 가입: https://www.sentinel-hub.com/
# Dashboard → User settings → OAuth clients → + 버튼
# 무료 계정: 월 30,000 Processing Unit
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── 3. Planet NICFI (4.77m 월간 모자이크) ──────────────────
# 가입: https://www.planet.com/nicfi/
# 비상업/연구 목적 무료 (열대 지역 중심)
PLANET_API_KEY=

# ── 4. NASA Earthdata (HLS, VIIRS, MODIS 1km) ─────────────
# 가입: https://urs.earthdata.nasa.gov/users/new
# 완전 무료
EARTHDATA_LOGIN=
EARTHDATA_PASSWORD=

# ── 5. USGS (Landsat 8/9) ─────────────────────────────────
# 가입: https://ers.cr.usgs.gov/register
# 완전 무료
USGS_USERNAME=
USGS_PASSWORD=

# ── 서버 설정 ──────────────────────────────────────────────
PORT=3000
